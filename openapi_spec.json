{
  "openapi": "3.1.0",
  "info": {
    "title": "Paracetamol Rumack Matthew Nomogram API",
    "description": "Reference nomogram (US/Canada 150-line) plus nonclinical legacy audit utilities. Runtime /openapi.json is authoritative.",
    "version": "3.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "Status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Counts for the legacy audit supervisor",
        "responses": {
          "200": {
            "description": "Counters"
          }
        }
      }
    },
    "/api/nomogram": {
      "post": {
        "summary": "Calculate the 150-line nomogram for a clinical reference",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "hours_post_ingestion",
                  "concentration_mcg_ml"
                ],
                "properties": {
                  "hours_post_ingestion": {
                    "type": "number"
                  },
                  "concentration_mcg_ml": {
                    "type": "number"
                  },
                  "ingestion_pattern": {
                    "type": "string",
                    "enum": [
                      "acute",
                      "repeated",
                      "unknown",
                      "modified_release"
                    ],
                    "default": "acute"
                  },
                  "time_known": {
                    "type": "boolean",
                    "default": true
                  },
                  "delayed_absorption": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nomogram comparison or not-applicable explanation"
          },
          "422": {
            "description": "Invalid measurement"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Nonclinical legacy audit demonstration",
        "responses": {
          "200": {
            "description": "Audit dossier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Nonclinical mock response",
        "responses": {
          "200": {
            "description": "Mock text"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory legacy audit logs",
        "responses": {
          "200": {
            "description": "Hash-chain status"
          }
        }
      }
    }
  }
}
